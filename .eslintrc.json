{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": "next/core-web-vitals",
  "rules": {
    "no-console": "warn",
    "prefer-const": "warn",
    "quotes": ["error", "sinsle"],
    "jsx-quotes": ["error", "prefer-double"],
    "indent": ["warn", 2],
    "max-len": ["warn", {
        "code": 120
      }
    ],
    "comma-dangle": ["warn", "always-multiline"],
    "semi": ["error", "always"],
    "import/order": ["error", {
        "groups": [
          "builtin",
          "external",
          "parent",
          "sibling",
          "index"
        ],
        "newlines-between": "always-and-inside-groups"
      }
    ],
    "eol-last": "off"
  }
}
